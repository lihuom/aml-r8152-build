=== rtl8152_get_speed ===

static u16 rtl8152_get_speed(struct r8152 *tp)
{
	u32 ocp_data;

	if (ocp_read_word(tp, MCU_TYPE_PLA, PLA_PHYSTATUS, &ocp_data) < 0)
		return 0; /* to do */
	else
		return (u16)ocp_data;
}

