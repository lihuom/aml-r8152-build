12846| static void set_carrier(struct r8152 *tp)
12847| {
12848| 	struct net_device *netdev = tp->netdev;
12849| 	struct napi_struct *napi = &tp->napi;
12850| 	u16 speed;
12851| 
12852| 	speed = rtl8152_get_speed(tp);
12853| 
12854| 	if (speed & LINK_STATUS) {
12855| 		if (!netif_carrier_ok(netdev)) {
12856| 			tp->rtl_ops.enable(tp);
12857| 			netif_stop_queue(netdev);
12858| 			napi_disable(napi);
12859| 			netif_carrier_on(netdev);
12860| 			rtl_start_rx(tp);
12861| 			rtl8152_set_rx_mode(netdev);
12862| 			napi_enable(napi);
12863| 			netif_wake_queue(netdev);
12864| 			netif_info(tp, link, netdev, "carrier on\n");
12865| 		} else if (netif_queue_stopped(netdev) &&
12866| 			   skb_queue_len(&tp->tx_queue) < tp->tx_qlen) {
12867| 			netif_wake_queue(netdev);
12868| 		}
12869| 	} else {
12870| 		if (netif_carrier_ok(netdev)) {
12871| 			netif_carrier_off(netdev);
12872| 			tasklet_disable(&tp->tx_tl);
12873| 			napi_disable(napi);
12874| 			tp->rtl_ops.disable(tp);
12875| 			napi_enable(napi);
12876| 			tasklet_enable(&tp->tx_tl);
12877| 			netif_info(tp, link, netdev, "carrier off\n");
12878| 		}
12879| 	}
12880| }
12881| 
12882| static inline void __rtl_work_func(struct r8152 *tp)
12883| {
12884| 	/* If the device is unplugged or !netif_running(), the workqueue
12885| 	 * doesn't need to wake the device, and could return directly.
12886| 	 */
12887| 	if (test_bit(RTL8152_UNPLUG, &tp->flags) || !netif_running(tp->netdev))
12888| 		return;
12889| 
12890| 	if (usb_autopm_get_interface(tp->intf) < 0)
12891| 		return;
12892| 
12893| 	if (!test_bit(WORK_ENABLE, &tp->flags))
12894| 		goto out1;
12895| 
12896| 	if (!mutex_trylock(&tp->control)) {
12897| 		if (tp->rtk_enable_diag)
12898| 			goto link_chg_only;
12899| 
12900| 		schedule_delayed_work(&tp->schedule, 0);
12901| 		goto out1;
12902| 	}
12903| 
12904| 	if (test_and_clear_bit(RTL8152_LINK_CHG, &tp->flags))
12905| 		set_carrier(tp);
12906| 
12907| 	if (test_bit(RTL8152_SET_RX_MODE, &tp->flags))
12908| 		rtl8152_set_rx_mode(tp->netdev);
12909| 
12910| 	/* don't schedule tasket before linking */
12911| 	if (test_and_clear_bit(SCHEDULE_TASKLET, &tp->flags) &&
12912| 	    netif_carrier_ok(tp->netdev))
12913| 		tasklet_schedule(&tp->tx_tl);
12914| 
12915| 	if (test_and_clear_bit(RX_EPROTO, &tp->flags) &&
12916| 	    !list_empty(&tp->rx_done))
12917| 		napi_schedule(&tp->napi);
12918| 
12919| 	mutex_unlock(&tp->control);
12920| 
12921| out1:
12922| 	usb_autopm_put_interface(tp->intf);
12923| 
12924| link_chg_only:
12925| 	if (test_and_clear_bit(RTL8152_LINK_CHG, &tp->flags)) {
12926| 		int lock;
12927| 
12928| 		rtnl_lock();
12929| 		lock = mutex_trylock(&tp->control);
12930| 		set_carrier(tp);
