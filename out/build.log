2627| 	if (!rx_agg)
2628| 		return NULL;
2629| 
2630| 	rx_agg->page = alloc_pages(mflags | __GFP_COMP | __GFP_NOWARN, order);
2631| 	pr_info("r8152-dbg-agg: page=%p order=%u mflags=0x%x\n",
2632| 		rx_agg->page, order, mflags);
2633| 	if (!rx_agg->page)
2634| 		goto free_rx;
2635| 
2636| 	rx_agg->buffer = page_address(rx_agg->page);
2637| 
2638| 	rx_agg->urb = usb_alloc_urb(0, mflags);
2639| 	pr_info("r8152-dbg-agg: urb=%p\n", rx_agg->urb);
2640| 	if (!rx_agg->urb)
2641| 		goto free_buf;
2642| 
2643| 	rx_agg->context = tp;
2644| 
2645| 	INIT_LIST_HEAD(&rx_agg->list);
2646| 	INIT_LIST_HEAD(&rx_agg->info_list);
2647| 	spin_lock_irqsave(&tp->rx_lock, flags);
2648| 	list_add_tail(&rx_agg->info_list, &tp->rx_info);
2649| 	spin_unlock_irqrestore(&tp->rx_lock, flags);
2650| 
2651| 	atomic_inc(&tp->rx_count);
2652| 
2653| 	return rx_agg;
2654| 
2655| free_buf:
